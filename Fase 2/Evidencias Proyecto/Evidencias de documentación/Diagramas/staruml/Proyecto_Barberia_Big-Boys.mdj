{
 "_type": "Project",
 "_id": "AAAAAAGBB00000001",
 "name": "Proyecto Barbería Big-Boys",
 "ownedElements": [
  {
   "_type": "UMLModel",
   "_id": "AAAAAAGBB00000002",
   "_parent": {
    "$ref": "AAAAAAGBB00000001"
   },
   "name": "Vista de escenarios (casos de uso)",
   "ownedElements": [
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000003",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Cliente registrado",
     "documentation": "Persona con cuenta que agenda, paga abonos y ejerce sus derechos como titular de datos."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000004",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Invitado",
     "documentation": "Persona que reserva sin crear cuenta, entregando solo nombre y teléfono."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000005",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Barbero",
     "documentation": "Colaborador que presta el servicio. En el sistema solo consulta cuántas atenciones lleva, el monto de cada una y el total acumulado a la fecha de la consulta. Su perfil y credenciales los crea y entrega el Dueño."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000006",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Administrador de sucursal (cajero/a)",
     "documentation": "Responsable operativo del local: registra la fila, confirma el servicio que se prestará, da inicio y término a la atención, registra montos y no-show, gestiona agenda y bloqueos y ve los reportes de su sucursal. Su perfil y credenciales los crea y entrega el Dueño."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000007",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Dueño / Administrador general",
     "documentation": "Responsable del negocio y de los datos: es el único que crea los perfiles de los colaboradores y les entrega sus credenciales; configura, ve el consolidado y atiende cumplimiento."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000008",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Pasarela de pago",
     "documentation": "Sistema externo (Webpay Plus / Mercado Pago) que procesa el abono; no comparte datos de tarjeta."
    },
    {
     "_type": "UMLActor",
     "_id": "AAAAAAGBB00000009",
     "_parent": {
      "$ref": "AAAAAAGBB00000002"
     },
     "name": "Sistema de notificaciones",
     "documentation": "Servicio externo de correo/push que envía confirmaciones, recordatorios y avisos."
    },
